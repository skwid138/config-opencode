{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "autoUpdate": false,
  // Master switch
  "enabled": true,
  // Disabled — trial complete. Re-enable for debugging.
  // Logs go to ~/.config/opencode/logs/dcp/
  "debug": false,
  // Detailed notifications for ongoing visibility
  "pruneNotification": "minimal",
  "pruneNotificationType": "chat",
  // Slash commands enabled (/dcp context, /dcp stats, /dcp compress, etc.)
  "commands": {
    "enabled": true,
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ]
  },
  // Autonomous mode active — automatic strategies still run as safety net.
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },
  // Protect the most recent turns from pruning
  "turnProtection": {
    "enabled": true,
    "turns": 2
  },
  // Conservative defaults — keep subagents and custom prompts off until trial proves stable
  "experimental": {
    "allowSubAgents": false,
    "customPrompts": false
  },
  // No extra file pattern protections beyond default tool protection
  "protectedFilePatterns": [],
  "compress": {
    "mode": "range",
    "permission": "allow",
    // Hide compressed content inline (reduces noise)
    "showCompression": false,
    "protectTags": true,
    "summaryBuffer": true,
    // Global 80K/40K is the fallback for any model not listed in modelMaxLimits/modelMinLimits.
    // Above max → strong compression nudges. Below min → no reminder nudges.
    "maxContextLimit": 80000,
    "minContextLimit": 40000,
    // Copilot primary-session models verified >128K through OpenCode on 2026-10-01
    // (Gandalf on claude-opus-5.5 observed at 134.8k tokens = 13%). 200K/100K is a
    // conservative operating band chosen over the 1M window because of context rot
    // (Anthropic context-engineering guidance) and per-token credit cost.
    // Keys are exact providerID/modelID. Use absolute numbers, never percentages:
    // "80%" of a 1M window would mean 800K.
    "modelMaxLimits": {
      "github-copilot/claude-opus-5.5": 200000,
      "github-copilot/claude-sonnet-5.5": 200000,
      "github-copilot/gpt-6.1-sol": 200000
    },
    "modelMinLimits": {
      "github-copilot/claude-opus-5.5": 100000,
      "github-copilot/claude-sonnet-5.5": 100000,
      "github-copilot/gpt-6.1-sol": 100000
    },
    "nudgeFrequency": 5,
    "iterationNudgeThreshold": 15,
    // Soft nudges — sessions are long but bounded; avoid aggressive interruption
    "nudgeForce": "soft",
    // Default protected tools (task, skill, todowrite, todoread) cover orchestration outputs
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],
    // Don't preserve user messages verbatim — allows compression of large pasted content
    "protectUserMessages": false
  },
  "strategies": {
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}