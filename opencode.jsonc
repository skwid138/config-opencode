{
    "$schema": "https://opencode.ai/config.json",
    "model": "github-copilot/claude-sonnet-5.5",
    "small_model": "github-copilot/gpt-6-luna",
    "agent": {
        "build": {
            "mode": "subagent",
            "hidden": true,
            "description": "Hidden by local config"
        },
        "plan": {
            "mode": "subagent",
            "hidden": true,
            "description": "Hidden by local config"
        },
        "general": {
            "mode": "subagent",
            "hidden": true,
            "description": "Hidden by local config"
        },
        "compaction": {
            "model": "github-copilot/claude-opus-5.5"
        },
        "title": {
            "model": "github-copilot/gpt-6-luna",
            "variant": "low"
        }
    },
    "instructions": [
        "instruction/repo-context.md",
        "instruction/script-usage.md",
        "instruction/agent-defaults.md"
    ],
    "permission": {
        "external_directory": {
            "*": "ask",
            "/Users/hunter/.config/opencode/*": "allow",
            "/Users/hunter/code/*": "allow",
            "/tmp/*": "allow",
            "/var/folders/q1/zwn7qv6n4xd9wx2hvrz6cm5m0000gn/T/opencode/*": "allow",
            "/Users/hunter/.nvm/*": "allow",
            "/Users/hunter/.cache/*": "allow",
            "/Users/hunter/.local/*": "allow",
            "/Users/hunter/Library/Caches/opencode/*": "allow",
            "/Users/hunter/go/*": "allow",
            "/opt/homebrew/*": "allow",
            "/usr/local/*": "allow",
            "/private/var/folders/q1/zwn7qv6n4xd9wx2hvrz6cm5m0000gn/T/opencode/*": "allow",
            "/usr/share/man/*": "allow",
            "*wpromute*": "deny"
        },
        "edit": "ask",
        "write": "ask",
        "bash": {
            "*": "ask",
            "bats": "allow",
            "bun test*": "allow",
            "brew info*": "allow",
            "cat *": "allow",
            "cd": "allow",
            "cd *": "allow",
            "diff *": "allow",
            "dig *": "allow",
            "arp -a": "allow",
            "arp -an": "allow",
            "dirname *": "allow",
            "echo *": "allow",
            "file *": "allow",
            "find *": "allow",
            "gh api *": "allow",
            "gh auth status": "allow",
            "gh issue list*": "allow",
            "gh issue view*": "allow",
            "gh pr checks*": "allow",
            "gh pr diff*": "allow",
            "gh pr list*": "allow",
            "gh pr summary*": "allow",
            "gh pr view*": "allow",
            "gh repo view*": "allow",
            "gh run list*": "allow",
            "gh run view*": "allow",
            "git add *": "allow",
            "git blame*": "allow",
            "git branch*": "allow",
            "git check-ignore *": "allow",
            "git diff*": "allow",
            "git grep*": "allow",
            "git log*": "allow",
            "git ls-files*": "allow",
            "git remote*": "allow",
            "git rev-parse*": "allow",
            "git show*": "allow",
            "git status*": "allow",
            "grep *": "allow",
            "head *": "allow",
            "jq *": "allow",
            "ls *": "allow",
            "make check*": "allow",
            "make format*": "allow",
            "make fmt*": "allow",
            "make lint*": "allow",
            "make test*": "allow",
            "mkdir *": "allow",
            "npm run lint*": "allow",
            "npm run prettier:fix*": "allow",
            "npm run typecheck*": "allow",
            "npm run types:check*": "allow",
            "npm test*": "allow",
            "npm view*": "allow",
            "npx tsc*": "allow",
            "npx vitest *": "allow",
            "ping *": "allow",
            "route get *": "allow",
            "route -n get *": "allow",
            "printenv*": "allow",
            "printf *": "allow",
            "ps": "allow",
            "ps *": "allow",
            "pwd": "allow",
            "readlink *": "allow",
            "rg *": "allow",
            "scutil --dns*": "allow",
            "sed *": "allow",
            "nl *": "allow",
            "sort": "allow",
            "sort *": "allow",
            "tail *": "allow",
            "tr *": "allow",
            "uniq *": "allow",
            "uv run pytest*": "allow",
            "wc *": "allow",
            "which *": "allow",
            "/Users/hunter/code/scripts/agent/branch-to-ticket.sh": "allow",
            "/Users/hunter/code/scripts/agent/branch-to-ticket.sh *": "allow",
            "/Users/hunter/code/scripts/agent/chrome_mcp.sh": "allow",
            "/Users/hunter/code/scripts/agent/chrome_mcp.sh *": "allow",
            "/Users/hunter/code/scripts/agent/gh-current-pr.sh": "allow",
            "/Users/hunter/code/scripts/agent/gh-current-pr.sh *": "allow",
            "/Users/hunter/code/scripts/agent/gh-pr-checks-summary.sh": "allow",
            "/Users/hunter/code/scripts/agent/gh-pr-checks-summary.sh *": "allow",
            "/Users/hunter/code/scripts/agent/gh-pr-comments.sh": "allow",
            "/Users/hunter/code/scripts/agent/gh-pr-comments.sh *": "allow",
            "/Users/hunter/code/scripts/agent/jira-fetch-ticket.sh": "allow",
            "/Users/hunter/code/scripts/agent/jira-fetch-ticket.sh *": "allow",
            "/Users/hunter/code/scripts/agent/opencode-deps-check.sh": "allow",
            "/Users/hunter/code/scripts/agent/opencode-deps-check.sh *": "allow",
            "/Users/hunter/code/scripts/agent/opencode-token-totals.sh": "allow",
            "/Users/hunter/code/scripts/agent/opencode-token-totals.sh *": "allow",
            "/Users/hunter/code/scripts/agent/scripts-doctor.sh": "allow",
            "/Users/hunter/code/scripts/agent/scripts-doctor.sh *": "allow",
            "/Users/hunter/code/scripts/agent/sonar-pr-issues.sh": "allow",
            "/Users/hunter/code/scripts/agent/sonar-pr-issues.sh *": "allow",
            "/Users/hunter/code/scripts/agent/permission-audit.sh": "allow",
            "/Users/hunter/code/scripts/agent/permission-audit.sh *": "allow",
            // Deliberate exception to the mutating-tool -> ask convention: pi-ssh is Pi-scoped but permits arbitrary remote execution, including sudo. The local start-anchored "sudo *" deny rule does not catch remote sudo sent through this wrapper.
            "/Users/hunter/code/scripts/agent/pi-ssh.sh": "allow",
            "/Users/hunter/code/scripts/agent/pi-ssh.sh *": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/auto-ticket-context.sh": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/auto-ticket-context.sh *": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/gcp-project-map.sh": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/gcp-project-map.sh *": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/gke-logs.sh": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/gke-logs.sh *": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/jira-find-qa-subtask.sh": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/jira-find-qa-subtask.sh *": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/jira-qa-render.sh": "allow",
            "/Users/hunter/code/wpromote/scripts/agent/jira-qa-render.sh *": "allow",
            "./tests/test_helper/bats-core/bin/bats *": "allow",
            "acli jira *": "allow",
            "bats *": "allow",
            "brew --prefix*": "allow",
            "brew list*": "allow",
            "npm info*": "allow",
            "npm root*": "allow",
            "opencode --version": "allow",
            "realpath *": "allow",
            "basename *": "allow",
            "true": "allow",
            "gh search *": "allow",
            "strings *": "allow",
            "stat *": "allow",
            "type *": "allow",
            "test *": "allow",
            "~/code/scripts/agent/*": "allow",
            "~/code/wpromote/scripts/agent/*": "allow",
            "command -v *": "allow",
            "log show*": "allow",
            "log stats*": "allow",
            "log help*": "allow",
            "/opt/homebrew/bin/opencode --help": "allow",
            "/opt/homebrew/bin/opencode --version": "allow",
            "/opt/homebrew/bin/opencode version": "allow",
            "git stash list*": "allow",
            "git stash show*": "allow",
            "git merge-base *": "allow",
            "git rev-list *": "allow",
            "git for-each-ref *": "allow",
            "git ls-tree *": "allow",
            "git cat-file *": "allow",
            "git --no-pager diff*": "allow",
            "git --no-pager log*": "allow",
            "git --no-pager show*": "allow",
            "git --no-ext-diff diff*": "allow",
            "shasum *": "allow",
            "docker ps*": "allow",
            "docker inspect *": "allow",
            "docker logs *": "allow",
            "gcloud config list*": "allow",
            "gcloud auth list*": "allow",
            "kubectl config current-context": "allow",
            "kubectl config get-contexts*": "allow",
            "sleep *": "allow",
            "wait": "allow",
            // Read-only inspection allows. Pair form ("cmd" + "cmd *") only: an attached trailing
            // "*" (e.g. "docker info*") would also match sibling commands like "docker information".
            "cut": "allow",
            "cut *": "allow",
            "paste": "allow",
            "paste *": "allow",
            "comm": "allow",
            "comm *": "allow",
            "col": "allow",
            "col *": "allow",
            "cmp": "allow",
            "cmp *": "allow",
            "expr": "allow",
            "expr *": "allow",
            "du": "allow",
            "du *": "allow",
            "df": "allow",
            "df *": "allow",
            "id": "allow",
            "id *": "allow",
            "whoami": "allow",
            "whoami *": "allow",
            "uname": "allow",
            "uname *": "allow",
            "sw_vers": "allow",
            "sw_vers *": "allow",
            "uptime": "allow",
            "uptime *": "allow",
            "read *": "allow",
            "continue": "allow",
            "break": "allow",
            "setopt nonomatch": "allow",
            "setopt nullglob": "allow",
            "git --version": "allow",
            "git --version *": "allow",
            "git worktree list": "allow",
            "git worktree list *": "allow",
            "git tag --list": "allow",
            "git tag --list *": "allow",
            "git tag -l": "allow",
            "git tag -l *": "allow",
            "git config --get": "allow",
            "git config --get *": "allow",
            "git config --list": "allow",
            "git config --list *": "allow",
            "docker context ls": "allow",
            "docker context ls *": "allow",
            "docker context show": "allow",
            "docker context show *": "allow",
            "docker version": "allow",
            "docker version *": "allow",
            "docker info": "allow",
            "docker info *": "allow",
            "docker images": "allow",
            "docker images *": "allow",
            "docker image ls": "allow",
            "docker image ls *": "allow",
            "docker image inspect": "allow",
            "docker image inspect *": "allow",
            "docker network ls": "allow",
            "docker network ls *": "allow",
            "docker network inspect": "allow",
            "docker network inspect *": "allow",
            "docker volume ls": "allow",
            "docker volume ls *": "allow",
            "docker volume inspect": "allow",
            "docker volume inspect *": "allow",
            "docker system df": "allow",
            "docker system df *": "allow",
            "docker compose ps": "allow",
            "docker compose ps *": "allow",
            "docker compose ls": "allow",
            "docker compose ls *": "allow",
            "brew outdated": "allow",
            "brew outdated *": "allow",
            "brew --repo": "allow",
            "brew --repo *": "allow",
            "brew services list": "allow",
            "brew services list *": "allow",
            "brew leaves": "allow",
            "brew leaves *": "allow",
            "brew config": "allow",
            "brew config *": "allow",
            "launchctl list": "allow",
            "launchctl list *": "allow",
            "launchctl print": "allow",
            "launchctl print *": "allow",
            "plutil -p": "allow",
            "plutil -p *": "allow",
            "defaults read": "allow",
            "defaults read *": "allow",
            "lsof": "allow",
            "lsof *": "allow",
            "netstat": "allow",
            "netstat *": "allow",
            "system_profiler": "allow",
            "system_profiler *": "allow",
            // ifconfig: exact forms only; "ifconfig <iface> <args>" can reconfigure interfaces.
            "ifconfig": "allow",
            "ifconfig -a": "allow",
            "orb status": "allow",
            "orb status *": "allow",
            "orb version": "allow",
            "orb version *": "allow",
            "orb list": "allow",
            "orb list *": "allow",
            "orbctl status": "allow",
            "orbctl status *": "allow",
            // sqlite3: only the -safe -readonly forms are allowed; anything else prompts.
            "sqlite3 -safe -readonly *": "allow",
            "sqlite3 -readonly -safe *": "allow",
            // Mutating scripts: "path*" form also catches tab separators and sibling names.
            "/Users/hunter/code/scripts/agent/gh-label-sync.sh*": "ask",
            "/Users/hunter/code/wpromote/scripts/agent/jira-create-subtask.sh*": "ask",
            "/Users/hunter/code/wpromote/scripts/agent/jira-update-subtask.sh*": "ask",
            // There is no broad "git -C *" allow (use the bash tool workdir instead); "git -C ..." prompts by
            // default. These asks are kept as a backstop in case a broad git -C allow is ever reintroduced.
            "git -C * push*": "ask",
            "git -C * reset*--hard*": "ask",
            "git -C * clean*": "ask",
            // "gh api *" above is a broad allow; re-gate mutating calls. Substring match intentionally
            // over-matches (fail-safe). Direct graphql via -f prompts — use gh-pr-comments.sh instead.
            "gh api *-X*": "ask",
            "gh api *--method*": "ask",
            "gh api *-f*": "ask",
            "gh api *-F*": "ask",
            "gh api *--field*": "ask",
            "gh api *--raw-field*": "ask",
            "gh api *--input*": "ask",
            // Write/exec side doors in otherwise-allowed read commands. These substring asks are speed
            // bumps for habitual forms, NOT a sandbox. Known accepted residuals:
            //   (1) any allowed "cmd *" admits "> file" redirect writes (cat/printf/cut/...); last-match-wins
            //       makes carve-outs impossible;
            //   (2) shell quote obfuscation (-e''xec, -no'n'ce) evades substring asks;
            //   (3) clustered short options (sed -nEHi.bak, sort -nro out in) evade;
            //   (4) sed w/e script commands;
            //   (5) git textconv / diff.external helpers.
            // Non-writer agents are bound by the hygiene hard boundaries in instruction/agent-defaults.md instead.
            "find *exec*": "ask",
            "find *-ok*": "ask",
            "find *delete*": "ask",
            "sqlite3 *nonce*": "ask",
            "sqlite3 *unsafe*": "ask",
            "sqlite3 *init*": "ask",
            "git *-O*": "ask",
            "git *--open-files-in-pager*": "ask",
            "git *--output*": "ask",
            "sort *-o*": "ask",
            "sort *-?o*": "ask",
            "sed *-i*": "ask",
            "sed *-I*": "ask",
            "sed *-?i*": "ask",
            "sed *-??i*": "ask",
            "sed *-?I*": "ask",
            "sed *-??I*": "ask",
            "brew outdated *--fetch-HEAD*": "ask",
            "lsof *-D*": "ask",
            // Hallucination canary: the real auto-ticket-context.sh lives under the wpromote path above.
            "/Users/hunter/code/scripts/agent/auto-ticket-context.sh*": "deny",
            "git push * --force*": "deny",
            "git push * -f*": "deny",
            "git push --force*": "deny",
            "git push -f*": "deny",
            "git -C * push*--force*": "deny",
            "git -C * push* -f*": "deny",
            "rm *": "deny",
            "sed -i *": "deny",
            "sed -i*": "deny",
            "sudo *": "deny",
            "*wpromute*": "deny"
        }
    },
    "plugin": [
        "@tarquinen/opencode-dcp@3.2.0",
        [
            "@skwid138/opencode-command-normalizer@0.2.0",
            {
                "roots": [
                    "~/code/scripts/agent",
                    "~/code/wpromote/scripts/agent"
                ]
            }
        ],
        "./plugins/src/vision-tool.ts",
        [
            "@skwid138/opencode-council@0.10.0",
            {
                "council": {
                    "reviewer": "saruman",
                    "debug": true,
                    "models": [
                        {
                            "providerID": "github-copilot",
                            "modelID": "claude-opus-5.5"
                        },
                        {
                            "providerID": "github-copilot",
                            "modelID": "gemini-3.8-flash"
                        },
                        {
                            "providerID": "github-copilot",
                            "modelID": "gpt-6.1-sol"
                        }
                    ],
                    "aggregator_model": {
                        "providerID": "github-copilot",
                        "modelID": "gpt-6.1-sol"
                    },
                    "quorum": 3,
                    "timeouts": {
                        "aggregator_ms": 120000
                    }
                }
            }
        ]
    ],
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "local/ministral-3b": {
                    "name": "Ministral 3 3B (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "local/qwen3-vl-8b": {
                    "name": "Qwen3 VL 8B (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "local/qwen3-vl-30b": {
                    "name": "Qwen3 VL 30B (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "local/qwen3-coder-next": {
                    "name": "Qwen3 Coder Next (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "local/qwen3.5-122b-a10b": {
                    "name": "Qwen3.5 122B A10B (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "local/gpt-oss-120b": {
                    "name": "GPT-OSS 120B (LM Studio)",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                }
            }
        }
    },
    "watcher": {
        "ignore": [
            "node_modules",
            ".git",
            "dist",
            "build",
            ".next",
            "coverage",
            "logs",
            ".stryker-tmp",
            "storybook-static",
            ".venv",
            "__pycache__"
        ]
    },
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@1.10.1",
                "--browserUrl",
                "http://127.0.0.1:9222"
            ],
            "enabled": true
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "exa": {
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp",
            "enabled": true
        },
        "figma": {
            "type": "remote",
            "url": "http://127.0.0.1:3845/mcp",
            "enabled": true
        }
    }
}
